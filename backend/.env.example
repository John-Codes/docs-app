# Copy this file to backend/.env and fill in real values.
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
QDRANT_URL=https://your-cluster-id.us-east-1-1.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# Embeddings always go through OpenRouter. This free NVIDIA model returns
# 2048-dim vectors.
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
EMBEDDING_DIMENSIONS=2048

# Chat answers. provider is nvidia or openrouter.
CHAT_PROVIDER=nvidia
CHAT_MODEL=openai/gpt-oss-20b
NVIDIA_API_KEY=nvapi-your-nvidia-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
CHAT_TOP_K=8

# Upload guard for Render's free 512 MB RAM instance.
MAX_UPLOAD_MB=50
